# ── Supabase (required) ──────────────────────────────────
# Service-role key — used by db-helpers.ts for direct DB access during tests
# Must match the API's Supabase project (apps/api/.env or api deployment env vars)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── API URL (optional, default: http://localhost:3001) ────
# Used as baseURL for all Playwright APIRequestContext calls
API_URL=http://localhost:3001

# ── E2E Test Users (optional, have defaults) ──────────────
# These users must already exist in Supabase Auth + profiles table
E2E_ADMIN_EMAIL=admin@mct.com
E2E_ADMIN_PASSWORD=Admin1234!
E2E_STUDENT_A_EMAIL=student-a@mct.com
E2E_STUDENT_A_PASSWORD=Student1234!
E2E_STUDENT_B_EMAIL=student-b@mct.com
E2E_STUDENT_B_PASSWORD=Student1234!
