# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=24h

# ── Supabase ───────────────────────────────────────────────────
# Service-role key bypasses RLS — keep this secret and NEVER expose it to the frontend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── Redis ──────────────────────────────────────────────────────
# Password must match the one in docker-compose.yml
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=localredis

# ── Zoom ───────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ── Mux ────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ── Bunny Stream (Phase 7E — PRODUCTION video provider) ───────
# BUSINESS DECISION (Phase 7E): the LMS launches with no existing content,
# so ALL newly created recordings use Bunny. Mux stays compiled/registered
# as a dormant rollback provider but must NOT receive production uploads.
#
# VIDEO_UPLOAD_PROVIDER controls where NEW uploads go:
#   bunny (default) → Bunny-first; uploads FAIL VISIBLY (503) if Bunny is
#                     not enabled/configured below. Never silent-fallbacks.
#   mux             → dormant emergency switch: temporarily route NEW uploads
#                     back to Mux without a code change (rollback path).
VIDEO_UPLOAD_PROVIDER=bunny
BUNNY_ENABLED=true
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=            # Stream library API key (AccessKey header) - server-side only
BUNNY_CDN_HOSTNAME=       # e.g. vz-xxxxx.b-cdn.net (or custom CDN hostname)
BUNNY_TOKEN_SIGNING_KEY=  # Pull Zone Token Authentication Key (library Security tab)
BUNNY_WEBHOOK_SECRET=     # library Read-Only API key (webhook signature secret)
BUNNY_CDN_TOKEN_TTL_SECONDS=14400        # CDN token lifetime (default 4h)
BUNNY_UPLOAD_SIGNATURE_TTL_SECONDS=86400 # TUS presign lifetime (official min >=3600)
# DEPRECATED (Phase 7E): batch-based routing was removed with the launch policy.
# Kept only as documentation of the retired Batch1=Mux/Batch2+=Bunny plan.
VIDEO_BUNNY_BATCH_IDS=

# ── Email — Resend (https://resend.com) ──────────────────────
# Sign up free → API Keys → Create Key → paste below
# Free tier: 3000 emails/month, 100/day
# For testing use: onboarding@resend.dev (works immediately, no DNS setup)
# For production: verify your domain in Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@mctlearn.com
