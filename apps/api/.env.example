# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=https://example.com

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=24h

# ── Session policy ─────────────────────────────────────────────
# single = one active session per user (new login replaces the old one).
# multi  = concurrent sessions allowed (intended for controlled
#          deployments such as the sales demo with a shared account).
# Client deployments must use single. Never invent other values —
# anything except single|multi fails API startup.
SESSION_POLICY=single

# ── Password management policy ───────────────────────────────────
# enabled  = normal self-service password flows (forgot/reset/change).
# disabled = self-service password flows are blocked server-side and
#            hidden in the web UI (intended for controlled deployments
#            such as the sales demo with a shared operator-managed
#            account). Admin/operator rotation paths are unaffected.
# Client deployments must use enabled. Never invent other values —
# anything except enabled|disabled fails API startup.
PASSWORD_MANAGEMENT=enabled

# ── Temporary demo access (sales-demo deployment only) ──────────
# enabled  = expose POST /demo/access (per-prospect temporary accounts,
#            ~30 min expiry, scheduled sweeper revokes sessions).
# disabled = endpoint behaves as absent (404). Client deployments must
#            leave this unset/disabled — never enable on client data.
# Unset defaults to disabled. Anything except enabled|disabled fails startup.
# TEMP_DEMO_ACCESS=disabled

# ── Supabase ───────────────────────────────────────────────────
# Service-role key bypasses RLS — keep this secret and NEVER expose it to the frontend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── Redis ──────────────────────────────────────────────────────
# Password must match the one in docker-compose.yml
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=localredis

# ── Zoom ───────────────────────────────────────────────────────
# ZOOM_ENABLED controls whether live Zoom operations are allowed at all.
#   enabled  = live classes allowed (requires the Zoom credentials below).
#   disabled = recorded-only deployment: live operations reject with an
#              intentional 503 instead of a generic credential 500.
# Unset defaults to enabled (preserves existing deployments exactly).
# Client deployments choose explicitly: true for live, false for recorded-only.
ZOOM_ENABLED=enabled
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
LIVE_SESSION_DEFAULT_HOST_ID=

# ── Mux ────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ── Bunny Stream (Phase 7E — PRODUCTION video provider) ───────
# BUSINESS DECISION (Phase 7E): the LMS launches with no existing content,
# so ALL newly created recordings use Bunny. Mux stays compiled/registered
# as a dormant rollback provider but must NOT receive production uploads.
#
# VIDEO_UPLOAD_PROVIDER controls where NEW uploads go:
#   bunny (default) → Bunny-first; uploads FAIL VISIBLY (503) if Bunny is
#                     not enabled/configured below. Never silent-fallbacks.
#   mux             → dormant emergency switch: temporarily route NEW uploads
#                     back to Mux without a code change (rollback path).
VIDEO_UPLOAD_PROVIDER=bunny
BUNNY_ENABLED=true
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=            # Stream library API key (AccessKey header) - server-side only
BUNNY_CDN_HOSTNAME=       # e.g. vz-xxxxx.b-cdn.net (or custom CDN hostname)
BUNNY_TOKEN_SIGNING_KEY=  # Pull Zone Token Authentication Key (library Security tab)
BUNNY_WEBHOOK_SECRET=     # library Read-Only API key (webhook signature secret)
BUNNY_CDN_TOKEN_TTL_SECONDS=14400        # CDN token lifetime (default 4h)
BUNNY_UPLOAD_SIGNATURE_TTL_SECONDS=86400 # TUS presign lifetime (official min >=3600)
# DEPRECATED (Phase 7E): batch-based routing was removed with the launch policy.
# Kept only as documentation of the retired Batch1=Mux/Batch2+=Bunny plan.
VIDEO_BUNNY_BATCH_IDS=

# ── Email — Resend (https://resend.com) ──────────────────────
# Sign up free → API Keys → Create Key → paste below
# Free tier: 3000 emails/month, 100/day
# For production: verify your domain in Resend dashboard
#   FROM must be a verified domain (e.g. noreply@example.com)
#   REPLY-TO is support mailbox — not used as FROM
# There is intentionally no default sender: EMAIL_FROM is required whenever
# RESEND_API_KEY is set. Without an API key the app runs in STUB MODE
# (emails logged, never sent).
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=support@example.com
# Required to accept Resend delivery webhooks; the endpoint rejects
# webhooks when this is unset (fail closed).
RESEND_WEBHOOK_SECRET=

# ── PDF generation (Puppeteer/Chrome) ──────────────────────────
# On Render: keep the cache dir below so the downloaded Chrome survives
# build → runtime; leave the executable path unset on Render.
PUPPETEER_CACHE_DIR=/opt/render/project/src/apps/api/.puppeteer-cache
# PUPPETEER_EXECUTABLE_PATH=<CUSTOM_HOST_ONLY>
