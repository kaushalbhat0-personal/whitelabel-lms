# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=24h

# ── Supabase ───────────────────────────────────────────────────
# Service-role key bypasses RLS — keep this secret and NEVER expose it to the frontend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── Redis ──────────────────────────────────────────────────────
# Password must match the one in docker-compose.yml
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=localredis

# ── Zoom ───────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ── Mux ────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ── Bunny Stream (Phase 7B — INACTIVE until verified) ─────────
# Do NOT enable until the Bunny integration spike confirms from external
# documentation: webhook catalogue + signature scheme, token enforcement
# model, and upload API shapes. See docs/rccf-phase7b-preimplementation-audit.md
# blockers B-1/B-2/B-3. While disabled, ALL uploads route to Mux.
BUNNY_ENABLED=false
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_SIGNING_KEY=
BUNNY_WEBHOOK_SECRET=
# Comma-separated batch UUIDs whose NEW uploads route to Bunny
# (only effective when BUNNY_ENABLED=true; mixed selections stay on Mux).
VIDEO_BUNNY_BATCH_IDS=

# ── Email — Resend (https://resend.com) ──────────────────────
# Sign up free → API Keys → Create Key → paste below
# Free tier: 3000 emails/month, 100/day
# For testing use: onboarding@resend.dev (works immediately, no DNS setup)
# For production: verify your domain in Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@mctlearn.com
